{{ define "consent_verified_claims" }}

    {{ range $key, $value := . }}
        {{ $length := len $value }}
        <div class="consent-verified__row">
            <div class="consent-scope-row consent-verified__scope-row--tight">
                <label for="{{ $key }}">
                    <div class="consent-verified__label">
                        {{ $key }}
                    </div>
                </label>
                <button type="button" aria-label="Show scope description" data-scope-name="{{ $key }}" class="scope-desc-toggle">
                    <i class="material-icons" data-icon-id="{{ $key }}">keyboard_arrow_down</i>
                </button>
            </div>
            <div data-desc-id="{{ $key }}" class="non-visible consent-verified__details">
                {{ range $value }}
                    <div class="consent-verified__detail-row">
                        <input type="hidden" name="verified_claims" value="{{ .Name }}" id="{{ .Name }}" >
                        {{ if gt $length 1}}
                            {{ or .Description .Name }} {{ if .Value }} ({{ .Value }}) {{ end }}
                        {{ else }}
                            {{ if .Value }} {{ .Value }} {{ else}} {{ or .Description .Name }} {{ end }}
                        {{ end }}
                    </div>
                {{ end}}
            </div>
        </div>
    {{ end }}

{{ end }}
