{{ define "consent_claims" }}

{{ range $key, $value := . }}
    {{ $length := len $value }}
    <div class="consent-claims__row">
        <div class="consent-scope-row consent-claims__scope-row--tight">
            <label for="{{ $key }}">
                <div class="consent-claims__label">
                    {{ $key }}
                </div>
            </label>
            <button type="button" aria-label="{{ T "authorization.consent-connect-id.consent_claims.show_scope_description" }}" data-scope-name="{{ $key }}" class="scope-desc-toggle">
                <i class="material-icons" data-icon-id="{{ $key }}">keyboard_arrow_down</i>
            </button>
        </div>
        <div data-desc-id="{{ $key }}" class="non-visible consent-claims__details">
            {{ range $value }}
                <div class="consent-claims__detail-row">
                    <input type="hidden" name="claims" value="{{ .Name }}" id="{{ .Name }}" >
                    {{ if gt $length 1}}
                        {{ or .Description .Name }} {{ if .Value }} ({{ .Value }}) {{ end }}
                    {{ else }}
                        {{ if .Value }} {{ .Value }} {{ else}} {{ or .Description .Name }} {{ end }}
                    {{ end }}
                </div>
            {{ end}}
        </div>
    </div>
{{ end }}

{{ end }}