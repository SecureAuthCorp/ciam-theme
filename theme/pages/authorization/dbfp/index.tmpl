{{ template "base" . }}

{{ define "title" }} Log in {{ end }}

{{ define "content" }}
  <div class="loading-overlay" id="loading-overlay">
    <div class="spinner"></div>
  </div>

  <noscript>
    <meta http-equiv="refresh" content="0; url={{ .Data.URL }}&dbfp=noscript" />
    <a href="{{ .Data.URL }}&dbfp=noscript">Continue</a>
  </noscript>

  <script src="/dbfp/bfp7.js" defer></script>

  <script nonce="{{ .Config.Nonce }}">
    const baseURL = `${window.location.protocol}//${window.location.host}`;
    const startTime = performance.now();
    let redirected = false;

    // The Java acceptance helper RiskEngineSpinnerHandler regex-scrapes the
    // redirectURL line below; keep it byte-identical.
    function redirect(status, duration) {
      if (redirected) {
        return;
      }
      redirected = true;
      const redirectURL = new URL(decodeURI("{{ .Data.URL }}"), baseURL);
      redirectURL.searchParams.set('dbfp', status);
      redirectURL.searchParams.set('duration', Math.round(duration));
      window.location.href = redirectURL.toString();
    }

    function submitFingerprint(data) {
      if (redirected) {
        return;
      }
      redirected = true;
      clearTimeout(dbfpTimeout);

      try {
        const duration = performance.now() - startTime;
        const actionURL = new URL(decodeURI("{{ .Data.URL }}"), baseURL);
        actionURL.searchParams.set('dbfp', 'success');
        actionURL.searchParams.set('duration', Math.round(duration));

        const form = document.createElement('form');
        form.method = 'post';
        form.action = actionURL.toString();

        const input = document.createElement('input');
        input.type = 'hidden';
        input.name = 'dbfp_data';
        input.value = data;

        form.appendChild(input);
        document.body.appendChild(form);
        form.submit();
      } catch (err) {
        console.log("dbfp submit failed", err);
        redirected = false;
        redirect('failure', performance.now() - startTime);
      }
    }

    const dbfpTimeout = setTimeout(() => {
      const duration = performance.now() - startTime;
      console.log("dbfp timeout");
      redirect('failure', duration);
    }, {{ .Data.Timeout }});

    document.addEventListener('DOMContentLoaded', () => {
      SecureAuth.getFingerprint({
        enableGps: false,
        jwtEnabled: false,
        rerunIntervalEnabled: false,
        mode: "balanced",
        onFingerprint: (data) => submitFingerprint(data),
      });
    });
  </script>
{{ end }}
