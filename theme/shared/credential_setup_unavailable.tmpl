{{ define "credential_setup_unavailable" }}

{{ template "credential_setup_unavailable_header" dict "Title" "identity.activate.credential_setup_unavailable.title" "Info" "identity.activate.credential_setup_unavailable.info" "Icon" .Data.Is2FAStep "Assets" .Config.Assets }}

{{ end }}

{{ define "credential_setup_unavailable_header" }}
<div class="setup-credential-header-container">
  <h1 class="no-bottom-margin">{{ T .Title }}</h1>
  {{ if .Icon }}
    <img src="{{ .Assets }}/static/images/2fa-icon.svg" alt="second factor step" class="icon-2fa"/>
  {{ end }}
</div>
<h3 class="no-bottom-margin">{{ T .Info }}</h3>
{{ end }}
