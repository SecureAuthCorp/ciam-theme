{{ define "header" }}

<div class="aut-banner-logo">
  {{ if eq .Styling.LogoURL "/static/images/no-logo.svg" }}
  {{ else if .Styling.LogoURL }}
    <img src="{{ .ImageProxyURL }}{{ .Styling.LogoURL }}" alt="Company logo" crossorigin="anonymous">
  {{ else }}
    <img src="{{ .Root }}/static/images/sa-logo-white.svg" alt="SecureAuth company logo" />
  {{ end }}
</div>

{{ if .I18n.SelectorEnabled }}
  {{ template "language_selector" dict "I18n" .I18n "Nonce" .Nonce "CurrentLocale" .I18n.CurrentLocale "SupportedLocales" .I18n.SupportedLocales "SelectorEnabled" .I18n.SelectorEnabled }}
{{ end }}

{{ end }}
