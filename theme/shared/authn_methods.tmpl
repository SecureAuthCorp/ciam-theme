{{ define "authn_card_attrs" -}}
  class="href-card{{ if .Kind }} href-card--badged{{ end }}"
  {{- if eq .Kind "unavailable" }} disabled{{ end }}
{{- end }}

{{ define "authn_badge" -}}
  {{ if .Kind -}}
    <span class="method-badge method-badge--{{ .Kind }}">{{ T .Chip }}</span>
  {{- end }}
  {{- if .Reason -}}
    <span class="method-reason">{{ T .Reason }}</span>
  {{- end }}
{{- end }}

{{ define "authn_methods_grid" }}

    <div id="authn-mode-switch-container">
      <div class="spacer-container">
        <div>{{ T "identity.login.authn_methods.or" }}{{ if not .Data.IsForceAuthMode}} {{ T "identity.login.authn_methods.log_in_with" }}{{ end }}</div>
      </div>

      <div class="authn-methods-grid{{ if .Data.MechanismBadges }} authn-methods-grid--badged{{ end }}" id="authn-methods-grid">
        {{ range $card := .Data.CardOrder }}
        {{ if eq $card "password" }}
        {{ if $.Data.AuthenticationMechanismsAvailability.password }}
          {{ if ne $.Data.HiddenCard "password" }}
              {{ $badge := $.Data.Badge "password" }}
              <button {{ template "authn_card_attrs" $badge }} type="submit" name="action" value="change_to_password" id="login-option-password">
                <div>
                  <span class="href-card-avatar href-card-avatar-with-img small-icon">
                    <img src="{{ $.Config.Assets }}/static/images/password-icon-2.svg" alt="password method image" />
                  </span>
                  <span{{ if $badge.Kind }} class="href-card-label"{{ end }}>{{ T "identity.login.authn_methods.password" }}</span>
                  {{ template "authn_badge" $badge }}
                </div>
              </button>
          {{ end }}
        {{ end }}
        {{ end }}

        {{ if eq $card "otp" }}
        {{ if $.Data.AuthenticationMechanismsAvailability.otp }}
            {{ if ne $.Data.HiddenCard "otp" }}
                {{ $badge := $.Data.Badge "otp" }}
                <button {{ template "authn_card_attrs" $badge }} type="submit" name="action" value="{{ if and (or $.Data.IsForceAuthMode $.Data.Is2FAStep (not (eq $.Data.Identifier ""))) (not $.Data.RequireUserConfirmationBeforeSend) }}send_otp{{ else }}change_to_otp{{ end }}" id="login-option-code">
                    <div>
                        <span class="href-card-avatar href-card-avatar-with-img small-icon">
                            <img src="{{ $.Config.Assets }}/static/images/otp-icon.svg" alt="verification code method image" />
                        </span>
                        <span{{ if $badge.Kind }} class="href-card-label"{{ end }}>{{ T "identity.login.authn_methods.verification_code" }}</span>
                  {{ template "authn_badge" $badge }}
                    </div>
                    </button>
            {{ end }}
        {{ end }}
        {{ end }}

        {{ if eq $card "webauthn" }}
        {{ if $.Data.AuthenticationMechanismsAvailability.webauthn }}
          {{ if ne $.Data.HiddenCard "webauthn" }}
              {{ $badge := $.Data.Badge "webauthn" }}
              <button {{ template "authn_card_attrs" $badge }} type="submit" name="action" value="change_to_web_authn" id="login-option-web-authn">
                <div>
                  <span class="href-card-avatar href-card-avatar-with-img small-icon">
                    <img src="{{ $.Config.Assets }}/static/images/webauthn-icon.svg" alt="passkey method image" />
                  </span>
                  <span{{ if $badge.Kind }} class="href-card-label"{{ end }}>{{ T "identity.login.authn_methods.passkey" }}</span>
                  {{ template "authn_badge" $badge }}
                </div>
              </button>
          {{ end }}
        {{ end }}
        {{ end }}

        {{ if eq $card "usernameless_webauthn" }}
        {{ if $.Data.AuthenticationMechanismsAvailability.usernameless_webauthn }}
          {{ if ne $.Data.HiddenCard "usernameless_webauthn" }}
              {{ $badge := $.Data.Badge "usernameless_webauthn" }}
              <button {{ template "authn_card_attrs" $badge }} type="submit" name="action" value="change_to_usernameless_web_authn" id="login-option-usernameless-web-authn">
                <div>
                  <span class="href-card-avatar href-card-avatar-with-img small-icon">
                    <img src="{{ $.Config.Assets }}/static/images/usernameless-webauthn-icon.svg" alt="smart passkey method image" />
                  </span>
                  <span{{ if $badge.Kind }} class="href-card-label"{{ end }}>{{ T "identity.login.authn_methods.usernameless_passkey" }}</span>
                  {{ template "authn_badge" $badge }}
                </div>
              </button>
          {{ end }}
        {{ end }}
        {{ end }}

        {{ if eq $card "totp" }}
        {{ if $.Data.AuthenticationMechanismsAvailability.totp }}
          {{ if ne $.Data.HiddenCard "totp" }}
              {{ $badge := $.Data.Badge "totp" }}
              <button {{ template "authn_card_attrs" $badge }} type="submit" name="action" value="change_to_totp" id="login-option-totp">
                <div>
                  <span class="href-card-avatar href-card-avatar-with-img small-icon">
                    <img src="{{ $.Config.Assets }}/static/images/smartphone-icon.svg" alt="totp method image" />
                  </span>
                  <span{{ if $badge.Kind }} class="href-card-label"{{ end }}>{{ T "identity.login.authn_methods.authenticator_code" }}</span>
                  {{ template "authn_badge" $badge }}
                </div>
              </button>
          {{ end }}
        {{ end }}
        {{ end }}

        {{ if eq $card "email_otp" }}
        {{ if $.Data.AuthenticationMechanismsAvailability.email_otp }}
          {{ if ne $.Data.HiddenCard "email_otp" }}
              {{ $badge := $.Data.Badge "email_otp" }}
              <button {{ template "authn_card_attrs" $badge }} type="submit" name="action" value="{{ if and (or $.Data.IsForceAuthMode $.Data.Is2FAStep (not (eq $.Data.Identifier ""))) (not $.Data.RequireUserConfirmationBeforeSend) }}send_email_otp{{ else }}change_to_email_otp{{ end }}" id="login-option-email-otp">
                  <div>
                    <span class="href-card-avatar href-card-avatar-with-img small-icon">
                        <img src="{{ $.Config.Assets }}/static/images/email-otp.svg" alt="email otp method image" />
                    </span>
                      <span{{ if $badge.Kind }} class="href-card-label"{{ end }}>{{ T "identity.login.authn_methods.email_otp" }}</span>
                  {{ template "authn_badge" $badge }}
                  </div>
                </button>
          {{ end }}
        {{ end }}
        {{ end }}

        {{ if eq $card "sms_otp" }}
        {{ if $.Data.AuthenticationMechanismsAvailability.sms_otp }}
          {{ if ne $.Data.HiddenCard "sms_otp" }}
              {{ $badge := $.Data.Badge "sms_otp" }}
              <button {{ template "authn_card_attrs" $badge }} type="submit" name="action" value="{{ if and (or $.Data.IsForceAuthMode $.Data.Is2FAStep (not (eq $.Data.Identifier ""))) (not $.Data.RequireUserConfirmationBeforeSend) }}send_sms_otp{{ else }}change_to_sms_otp{{ end }}" id="login-option-sms-otp">
                  <div>
                    <span class="href-card-avatar href-card-avatar-with-img small-icon">
                        <img src="{{ $.Config.Assets }}/static/images/sms-otp.svg" alt="sms otp method image" />
                    </span>
                      <span{{ if $badge.Kind }} class="href-card-label"{{ end }}>{{ T "identity.login.authn_methods.sms_otp" }}</span>
                  {{ template "authn_badge" $badge }}
                  </div>
                </button>
          {{ end }}
        {{ end }}
        {{ end }}

        {{ if eq $card "voice_otp" }}
        {{ if $.Data.AuthenticationMechanismsAvailability.voice_otp }}
          {{ if ne $.Data.HiddenCard "voice_otp" }}
              {{ $badge := $.Data.Badge "voice_otp" }}
              <button {{ template "authn_card_attrs" $badge }} type="submit" name="action" value="{{ if and (or $.Data.IsForceAuthMode $.Data.Is2FAStep (not (eq $.Data.Identifier ""))) (not $.Data.RequireUserConfirmationBeforeSend) }}send_voice_otp{{ else }}change_to_voice_otp{{ end }}" id="login-option-voice-otp">
                  <div>
                    <span class="href-card-avatar href-card-avatar-with-img small-icon">
                        <img src="{{ $.Config.Assets }}/static/images/voice-otp.svg" alt="voice otp method image" />
                    </span>
                      <span{{ if $badge.Kind }} class="href-card-label"{{ end }}>{{ T "identity.login.authn_methods.voice_otp" }}</span>
                  {{ template "authn_badge" $badge }}
                  </div>
                </button>
          {{ end }}
        {{ end }}
        {{ end }}

        {{ if eq $card "push" }}
        {{ if $.Data.AuthenticationMechanismsAvailability.push }}
          {{ if ne $.Data.HiddenCard "push" }}
              {{ $badge := $.Data.Badge "push" }}
              <button {{ template "authn_card_attrs" $badge }} type="submit" name="action" value="{{ if or $.Data.IsForceAuthMode $.Data.Is2FAStep (not (eq $.Data.Identifier ""))}}send_push{{ else }}change_to_push{{ end }}" id="login-option-push">
                <div>
                  <span class="href-card-avatar href-card-avatar-with-img small-icon">
                    <img src="{{ $.Config.Assets }}/static/images/push-icon.svg" alt="push method image" />
                  </span>
                  <span{{ if $badge.Kind }} class="href-card-label"{{ end }}>{{ T "identity.login.authn_methods.push" }}</span>
                  {{ template "authn_badge" $badge }}
                </div>
              </button>
          {{ end }}
        {{ end }}
        {{ end }}

        {{ if eq $card "symbol" }}
        {{ if $.Data.AuthenticationMechanismsAvailability.symbol }}
          {{ if ne $.Data.HiddenCard "symbol" }}
              {{ $badge := $.Data.Badge "symbol" }}
              <button {{ template "authn_card_attrs" $badge }} type="submit" name="action" value="{{ if or $.Data.IsForceAuthMode $.Data.Is2FAStep (not (eq $.Data.Identifier ""))}}send_symbol{{ else }}change_to_symbol{{ end }}" id="login-option-symbol">
                <div>
                  <span class="href-card-avatar href-card-avatar-with-img small-icon">
                    <img src="{{ $.Config.Assets }}/static/images/symbol-icon.svg" alt="symbol method image" />
                  </span>
                  <span{{ if $badge.Kind }} class="href-card-label"{{ end }}>{{ T "identity.login.authn_methods.symbol" }}</span>
                  {{ template "authn_badge" $badge }}
                </div>
              </button>
          {{ end }}
        {{ end }}
        {{ end }}

        {{ if eq $card "qr_code" }}
        {{ if $.Data.AuthenticationMechanismsAvailability.qr_code }}
          {{ if ne $.Data.HiddenCard "qr_code" }}
              {{ $badge := $.Data.Badge "qr_code" }}
              <button {{ template "authn_card_attrs" $badge }} type="submit" name="action" value="change_to_qr_code" id="login-option-qr_code">
                <div>
                  <span class="href-card-avatar href-card-avatar-with-img small-icon">
                    <img src="{{ $.Config.Assets }}/static/images/qr-code-icon.svg" alt="qr code method image" />
                  </span>
                  <span{{ if $badge.Kind }} class="href-card-label"{{ end }}>{{ T "identity.login.authn_methods.qr_code" }}</span>
                  {{ template "authn_badge" $badge }}
                </div>
              </button>
          {{ end }}
        {{ end }}
        {{ end }}
        {{ end }}
      </div>
    </div>

    {{ template "methods_grid_script" dict "Nonce" .Nonce "GridId" "authn-methods-grid" }}

{{ end }}